# Plantilla de variables. Copia este archivo a .env y rellena los valores reales.
# No subas nunca el .env con secretos al repositorio.

# --- Proveedor de IA (solo servidor) ---
AI_PROVIDER_API_KEY=tu_api_key_de_gemini
AI_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=gemini-3.5-flash
AI_TIMEOUT_SECONDS=30

# --- Clerk ---
# Clave publicable: se incrusta en el bundle del frontend durante la compilación.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_tu_clave_publicable
# Clave secreta: solo se usa en FastAPI para validar el JWT. Nunca en el frontend.
CLERK_SECRET_KEY=sk_test_tu_clave_secreta
# Orígenes permitidos para el claim azp, separados por comas.
# En Vercel añade https://TU-PROYECTO.vercel.app y en EC2 http://IP_PUBLICA:PUERTO.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
