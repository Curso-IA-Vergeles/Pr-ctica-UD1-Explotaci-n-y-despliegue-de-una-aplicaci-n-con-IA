# Clave de API para el proveedor de IA (ej: Google Gemini o OpenAI)
AI_PROVIDER_API_KEY=tu_api_key_aqui

# Configuración opcional para proveedores compatibles con OpenAI (ej: Google Gemini)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash

# Variables de autenticación (Clerk)
VITE_CLERK_PUBLISHABLE_KEY=dummy_clerk_pub_key
CLERK_SECRET_KEY=dummy_clerk_secret_key